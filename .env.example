# LifeLink environment configuration — EXAMPLE ONLY
#
# Copy to .env and fill in. NEVER commit a real .env; it is gitignored.
# Every value here is a placeholder. No real credential belongs in this file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# local | dev | staging | prod
# Controls local adapters, the demo-seeding guard and table naming.
LIFELINK_ENV=local

# Prefix for every DynamoDB table name.
LIFELINK_TABLE_PREFIX=lifelink

# Shows the demo banner in the frontend.
LIFELINK_DEMO=true

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
# The project is pinned to a single region. Do not change this.
AWS_REGION=ap-southeast-2

# Local only: points the DynamoDB client at the local endpoint.
# MUST be empty or absent when running against real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# Local only: dummy credentials for the local endpoint.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# AWS only. Left empty locally, where a development keypair is used instead.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Local only: public key used to verify locally minted development tokens.
LOCAL_JWT_PUBLIC_KEY=.local-keys/dev_public.pem

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# A verified SES sender. Empty disables email.
# The account's SES is in sandbox: 200 messages/day, verified recipients only.
SES_SENDER=

# SMS is NOT IMPLEMENTED. There is no variable for it, deliberately:
# AWS End User Messaging SMS is a Paid-Plan service and is denied by this
# account's service control policy.

# ---------------------------------------------------------------------------
# Location services
# ---------------------------------------------------------------------------
# AWS only. Empty locally, where a static offline geocoder is used and
# routing is disabled.
LOCATION_PLACE_INDEX=
LOCATION_ROUTE_CALCULATOR=

# ---------------------------------------------------------------------------
# Queues
# ---------------------------------------------------------------------------
WORK_QUEUE_URL=
NOTIFICATION_QUEUE_URL=

# ---------------------------------------------------------------------------
# Frontend (Vite — these are PUBLIC, they ship in the browser bundle)
# ---------------------------------------------------------------------------
# Never put a secret in a VITE_ variable.

# Base path for API calls. The dev server proxies /api to localhost:8080.
VITE_API_BASE=/api

# Amazon Location style descriptor URL. Empty renders the facility list
# instead of a map, which is the local default.
VITE_MAP_STYLE_URL=

# ---------------------------------------------------------------------------
# CORS (local server only)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
